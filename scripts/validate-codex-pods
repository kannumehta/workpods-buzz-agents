#!/usr/bin/env python3
from __future__ import annotations

import sys
import tomllib
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PODS_FILE = ROOT / "pods" / "pods.toml"
COMPOSE_FILE = ROOT / "compose.codex-pods.yml"
ENTRYPOINT = ROOT / "scripts" / "codex-pod-entrypoint"
SYSTEM_PREFIX = ROOT / "pods" / "common" / "system-prefix.md"

EXPECTED_PODS = [
    "workpod",
    "geo-pod",
    "content-pod",
    "performance-pod",
    "lifecycle-pod",
    "marketing-pod",
    "support-desk-pod",
]

STALE_SOUL_SKILL_PATTERNS = [
    "use these skills",
    "installed skill",
    "blueprint skill",
    "workpods-mcp-access-diagnostics",
]


def fail(message: str) -> None:
    print(f"validate-codex-pods: {message}", file=sys.stderr)
    raise SystemExit(1)


def main() -> int:
    manifest = tomllib.loads(PODS_FILE.read_text(encoding="utf-8"))
    defaults = manifest.get("defaults", {})
    pods = manifest.get("pods", {})
    if list(pods) != EXPECTED_PODS:
        fail(f"pod order/name mismatch: {list(pods)}")
    if defaults.get("model") != "gpt-5.6-luna":
        fail("default model must be gpt-5.6-luna")
    if defaults.get("model_reasoning_effort") != "max":
        fail("default reasoning effort must be max")
    if defaults.get("respond_to") != "anyone":
        fail("pods must be team-facing respond_to=anyone")

    compose = COMPOSE_FILE.read_text(encoding="utf-8")
    entrypoint = ENTRYPOINT.read_text(encoding="utf-8")
    system_prefix = SYSTEM_PREFIX.read_text(encoding="utf-8")
    if "model = \"gpt-5.6-luna\"" not in entrypoint:
        fail("entrypoint does not render gpt-5.6-luna")
    if "model_reasoning_effort = \"max\"" not in entrypoint:
        fail("entrypoint does not render max reasoning")
    if "BUZZ_ACP_RESPOND_TO: anyone" not in compose:
        fail("compose does not set team-wide respond_to")
    if "[skills.bundled]" not in entrypoint or "enabled = false" not in entrypoint:
        fail("entrypoint must disable Codex bundled skills")
    if 'ln -sfnT "${pod_root}/skills"' in entrypoint:
        fail("entrypoint must not install pod skills")
    if "Incoming messages include a `From:` field" not in system_prefix:
        fail("system prefix missing From collaboration contract")
    if "Use plain `@Name` text" not in system_prefix:
        fail("system prefix missing mention collaboration contract")
    if "When an action is blocked by permission mode" not in system_prefix:
        fail("system prefix missing permission-mode reporting contract")

    for pod, config in pods.items():
        pod_dir = ROOT / "pods" / pod
        if not (pod_dir / "SOUL.md").is_file():
            fail(f"{pod}: missing SOUL.md")
        soul = (pod_dir / "SOUL.md").read_text(encoding="utf-8").lower()
        stale_patterns = [
            pattern for pattern in STALE_SOUL_SKILL_PATTERNS if pattern in soul
        ]
        if stale_patterns:
            fail(f"{pod}: SOUL.md has stale skill instructions: {stale_patterns}")
        if not (pod_dir / "memories" / "USER.md").is_file():
            fail(f"{pod}: missing memories/USER.md")
        service = f"workpods-agent-{pod}"
        if service not in compose:
            fail(f"{pod}: missing compose service {service}")
        env_path = "${WORKPODS_UMBRELLA_ROOT:-/home/ubuntu/workpods-umbrella}/.runtime/secrets/buzz-agents/pods/" + f"{pod}.env"
        if env_path not in compose:
            fail(f"{pod}: missing compose env_file {env_path}")
        if f"WORKPODS_POD_NAME: {pod}" not in compose:
            fail(f"{pod}: compose missing WORKPODS_POD_NAME")

        if "skills" in config:
            fail(f"{pod}: skills must not be declared")
        if (pod_dir / "skills").exists():
            fail(f"{pod}: skills directory must not exist")

        example = ROOT / "secrets" / "pods" / f"{pod}.env.example"
        if not example.is_file():
            fail(f"{pod}: missing env example")
        example_text = example.read_text(encoding="utf-8")
        if config["workpods_tool_profile"] not in example_text:
            fail(f"{pod}: env example missing tool profile")

    print("validate-codex-pods: ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
