 """
 
 import asyncio
+import hashlib
 import json
 import time
 
@@ -119,3 +120,165 @@ async def test_websocket_auth_raises_on_rejection():
         await adapter._authenticate_websocket(RejectingWs())
 
 
+def _published_events(websocket):
+    return [frame[1] for frame in websocket.sent if frame[0] == "EVENT"]
+
+
+def _assert_event_id_and_signature_shape(event):
+    serialized = json.dumps(
+        [
+            0,
+            event["pubkey"],
+            event["created_at"],
+            event["kind"],
+            event["tags"],
+            event["content"],
+        ],
+        separators=(",", ":"),
+        ensure_ascii=False,
+    ).encode("utf-8")
+    assert event["id"] == hashlib.sha256(serialized).hexdigest()
+    assert len(bytes.fromhex(event["sig"])) == 64
+
+
+@pytest.mark.asyncio
+async def test_typing_event_uses_channel_and_thread_tags():
+    adapter = _make_adapter()
+    websocket = _FakeWebSocket()
+    adapter._ws_socket = websocket
+    adapter._ws_active = True
+
+    await adapter.send_typing(
+        CHANNEL,
+        metadata={"root_event_id": "a" * 64, "parent_event_id": "b" * 64},
+    )
+
+    event = _published_events(websocket)[0]
+    assert event["kind"] == 20002
+    assert event["content"] == ""
+    assert event["tags"] == [
+        ["h", CHANNEL],
+        ["e", "a" * 64, "", "root"],
+        ["e", "b" * 64, "", "reply"],
+    ]
+    _assert_event_id_and_signature_shape(event)
+
+
+@pytest.mark.asyncio
+async def test_typing_is_noop_without_authenticated_websocket():
+    adapter = _make_adapter()
+    websocket = _FakeWebSocket()
+    adapter._ws_socket = websocket
+
+    await adapter.send_typing(CHANNEL)
+
+    assert websocket.sent == []
+
+
+@pytest.mark.asyncio
+async def test_presence_heartbeat_refreshes_online(monkeypatch):
+    adapter = _make_adapter()
+    websocket = _FakeWebSocket()
+    monkeypatch.setattr(_buzz_mod, "_WS_PRESENCE_REFRESH_SECONDS", 0.01)
+
+    task = asyncio.create_task(adapter._presence_heartbeat(websocket))
+    for _ in range(100):
+        if len(_published_events(websocket)) >= 2:
+            break
+        await asyncio.sleep(0.005)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+
+    events = _published_events(websocket)
+    assert len(events) >= 2
+    assert all(event["kind"] == 20001 for event in events)
+    assert all(event["content"] == "online" for event in events)
+
+
+@pytest.mark.asyncio
+async def test_stop_presence_cancels_heartbeat_before_offline():
+    adapter = _make_adapter()
+    websocket = _FakeWebSocket()
+    adapter._presence_task = asyncio.create_task(asyncio.sleep(60))
+
+    await adapter._stop_presence(websocket)
+
+    assert adapter._presence_task is None
+    event = _published_events(websocket)[-1]
+    assert event["kind"] == 20001
+    assert event["content"] == "offline"
+    _assert_event_id_and_signature_shape(event)
+
+
+@pytest.mark.asyncio
+async def test_multiplexed_adapters_publish_on_separate_sockets():
+    first = _make_adapter()
+    second = _make_adapter()
+    first_socket = _FakeWebSocket()
+    second_socket = _FakeWebSocket()
+    first._ws_socket = first_socket
+    second._ws_socket = second_socket
+    first._ws_active = True
+    second._ws_active = True
+
+    await asyncio.gather(first.send_typing(CHANNEL), second.send_typing(CHANNEL))
+
+    assert len(_published_events(first_socket)) == 1
+    assert len(_published_events(second_socket)) == 1
+
+
+@pytest.mark.asyncio
+async def test_websocket_loop_publishes_offline_before_socket_close(monkeypatch):
+    import websockets
+
+    actions = []
+
+    class LifecycleSocket(_FakeWebSocket):
+        async def send(self, raw):
+            frame = json.loads(raw)
+            self.sent.append(frame)
+            if frame[0] == "EVENT":
+                actions.append(frame[1]["content"])
+
+        def __aiter__(self):
+            return self
+
+        async def __anext__(self):
+            await asyncio.Future()
+
+    class Connection:
+        def __init__(self, websocket):
+            self.websocket = websocket
+
+        async def __aenter__(self):
+            return self.websocket
+
+        async def __aexit__(self, exc_type, exc, traceback):
+            actions.append("socket-closed")
+
+    websocket = LifecycleSocket()
+    adapter = _make_adapter()
+
+    async def authenticate(_websocket):
+        return None
+
+    async def subscribe(_websocket):
+        return {}
+
+    adapter._authenticate_websocket = authenticate
+    adapter._subscribe_websocket = subscribe
+    monkeypatch.setattr(websockets, "connect", lambda *args, **kwargs: Connection(websocket))
+
+    task = asyncio.create_task(adapter._websocket_loop())
+    for _ in range(100):
+        if "online" in actions:
+            break
+        await asyncio.sleep(0.005)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+
+    assert actions == ["online", "offline", "socket-closed"]
+    assert adapter._ws_socket is None
+    assert adapter._presence_task is None
