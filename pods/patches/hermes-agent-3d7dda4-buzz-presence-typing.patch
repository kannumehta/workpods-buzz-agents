     async def send_typing(self, chat_id: str, metadata=None) -> None:
-        """Buzz has no typing indicator API — no-op."""
-        pass
+        """Publish a short-lived Buzz typing event on the authenticated socket."""
+        websocket = self._ws_socket
+        if not self._ws_active or websocket is None:
+            return
+        tags = [["h", str(chat_id)]]
+        metadata = metadata or {}
+        root = metadata.get("root_event_id")
+        parent = (
+            metadata.get("parent_event_id")
+            or metadata.get("reply_to_message_id")
+            or metadata.get("thread_id")
+        )
+        if root and root != parent:
+            tags.append(["e", str(root), "", "root"])
+        if parent:
+            tags.append(["e", str(parent), "", "reply"])
+        try:
+            await self._publish_websocket_event(
+                websocket,
+                self._signed_nostr_event(_WS_TYPING_KIND, tags, ""),
+            )
+        except Exception:
+            logger.debug("Buzz: typing indicator publish failed", exc_info=True)
 
     async def send_reaction(self, chat_id: str, message_id: str, emoji: str) -> bool:
