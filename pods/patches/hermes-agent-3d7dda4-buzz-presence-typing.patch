             {"kinds": [_CHAT_KIND], "#h": [channel_id], "since": since},
         ]
-        await websocket.send(json.dumps(request, separators=(",", ":")))
+        await self._send_websocket_frame(websocket, request)
+
+    async def _send_websocket_frame(self, websocket, frame: list) -> None:
+        """Serialize writes shared by subscriptions, presence, and typing."""
+        async with self._ws_send_lock:
+            await websocket.send(json.dumps(frame, separators=(",", ":")))
+
+    async def _publish_websocket_event(self, websocket, event: dict) -> None:
+        await self._send_websocket_frame(websocket, ["EVENT", event])
+
+    async def _publish_presence(self, websocket, status: str) -> None:
+        event = self._signed_nostr_event(_WS_PRESENCE_KIND, [], status)
+        await self._publish_websocket_event(websocket, event)
+
+    async def _presence_heartbeat(self, websocket) -> None:
+        try:
+            while True:
+                await asyncio.sleep(_WS_PRESENCE_REFRESH_SECONDS)
+                await self._publish_presence(websocket, "online")
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            logger.debug("Buzz: presence heartbeat stopped", exc_info=True)
+
+    async def _stop_presence(self, websocket) -> None:
+        task = self._presence_task
+        self._presence_task = None
+        if task and not task.done():
+            task.cancel()
+            try:
+                await task
+            except asyncio.CancelledError:
+                pass
+        try:
+            await self._publish_presence(websocket, "offline")
+        except Exception:
+            logger.debug("Buzz: offline presence publish failed", exc_info=True)
 
     async def _subscribe_websocket(self, websocket) -> Dict[str, Optional[str]]:
         """Subscribe to every watched conversation plus membership events
