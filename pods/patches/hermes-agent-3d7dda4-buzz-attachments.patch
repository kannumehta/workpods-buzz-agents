+def _safe_media_filename(filename: str, fallback: str) -> str:
+    """Return a cache filename without path separators or control chars."""
+    name = unquote(filename or "").strip() or fallback
+    name = name.rsplit("/", 1)[-1].rsplit("\\", 1)[-1]
+    name = re.sub(r"[^A-Za-z0-9._ -]+", "_", name).strip(" .")
+    return name[:180] or fallback
+
+
+def _parse_imeta_tags(tags: Any) -> List[Dict[str, str]]:
+    """Extract NIP-92 imeta fields from Buzz event tags."""
+    items: List[Dict[str, str]] = []
+    if not isinstance(tags, list):
+        return items
+    for tag in tags:
+        if not isinstance(tag, list) or not tag or tag[0] != "imeta":
+            continue
+        entry: Dict[str, str] = {}
+        for part in tag[1:]:
+            if not isinstance(part, str) or " " not in part:
+                continue
+            key, value = part.split(" ", 1)
+            key = key.strip().lower()
+            value = value.strip()
+            if key and value:
+                entry[key] = value
+        if entry.get("url"):
+            items.append(entry)
+    return items
+
+
+def _message_type_for_media(media_types: List[str]) -> MessageType:
+    """Choose the Hermes message type for a set of downloaded media files."""
+    lowered = [(m or "").lower() for m in media_types]
+    if any(m and not m.startswith(("image/", "video/", "audio/")) for m in lowered):
+        return MessageType.DOCUMENT
+    if any(m.startswith("image/") for m in lowered):
+        return MessageType.PHOTO
+    if any(m.startswith("video/") for m in lowered):
+        return MessageType.VIDEO
+    if any(m.startswith("audio/") for m in lowered):
+        return MessageType.AUDIO
+    return MessageType.DOCUMENT if media_types else MessageType.TEXT
+
