+    async def _download_imeta_media(
+        self,
+        event_id: str,
+        entries: List[Dict[str, str]],
+    ) -> Tuple[List[str], List[str]]:
+        """Download Buzz imeta attachments into the Hermes profile cache."""
+        media_urls: List[str] = []
+        media_types: List[str] = []
+        for index, entry in enumerate(entries):
+            url = entry.get("url", "").strip()
+            if not url:
+                continue
+            mime_type = entry.get("m", "").strip()
+            parsed = urlsplit(url)
+            url_name = Path(unquote(parsed.path)).name
+            ext = Path(url_name).suffix
+            if not ext and mime_type:
+                ext = mimetypes.guess_extension(mime_type.split(";", 1)[0].strip()) or ""
+            digest = re.sub(r"[^0-9a-fA-F]", "", entry.get("x", ""))[:16]
+            fallback = f"{digest or event_id[:12]}-{index}{ext or '.bin'}"
+            safe_name = _safe_media_filename(entry.get("filename") or url_name, fallback)
+            if digest and not safe_name.startswith(digest):
+                safe_name = f"{digest}-{safe_name}"
+            target = self._media_cache_dir() / safe_name
+
+            expected_size: Optional[int] = None
+            try:
+                expected_size = int(entry.get("size", "") or "0") or None
+            except ValueError:
+                expected_size = None
+            try:
+                if target.is_file() and (expected_size is None or target.stat().st_size == expected_size):
+                    media_urls.append(str(target))
+                    media_types.append(mime_type or mimetypes.guess_type(target.name)[0] or "")
+                    continue
+            except OSError:
+                pass
+
+            tmp = target.with_name(f".{target.name}.part")
+            code, _out, err = await self._run_cli(
+                ["media", "get", url, "-o", str(tmp)],
+                timeout=_MEDIA_CLI_TIMEOUT,
+            )
+            if code != 0:
+                logger.warning(
+                    "Buzz: failed to download media attachment for event %s — %s",
+                    event_id[:12],
+                    _cli_error_message(err, code),
+                )
+                try:
+                    tmp.unlink(missing_ok=True)
+                except OSError:
+                    pass
+                continue
+            try:
+                tmp.replace(target)
+            except OSError as e:
+                logger.warning("Buzz: failed to finalize media attachment cache file: %s", e)
+                continue
+            media_urls.append(str(target))
+            media_types.append(mime_type or mimetypes.guess_type(target.name)[0] or "")
+        return media_urls, media_types
