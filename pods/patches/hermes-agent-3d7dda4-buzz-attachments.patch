+    def _relay_http_url(self, path: str) -> str:
+        parsed = urlsplit(self.relay_url.strip())
+        scheme = {"ws": "http", "wss": "https"}.get(parsed.scheme, parsed.scheme)
+        base_path = (parsed.path or "").rstrip("/")
+        return urlunsplit((scheme, parsed.netloc, f"{base_path}{path}", "", ""))
+
+    def _signed_nostr_event(self, kind: int, tags: List[List[str]], content: str) -> dict:
+        if not self._private_key:
+            self._private_key = _resolve_private_key(self._extra)
+        nostr_auth = _load_nostr_auth()
+        pubkey = nostr_auth.public_key_hex(self._private_key)
+        created_at = int(time.time())
+        serialized = json.dumps(
+            [0, pubkey, created_at, kind, tags, content],
+            separators=(",", ":"),
+            ensure_ascii=False,
+        ).encode("utf-8")
+        event_id = hashlib.sha256(serialized).digest()
+        return {
+            "id": event_id.hex(),
+            "pubkey": pubkey,
+            "created_at": created_at,
+            "kind": kind,
+            "tags": tags,
+            "content": content,
+            "sig": nostr_auth.schnorr_sign(event_id, self._private_key).hex(),
+        }
+
+    def _blossom_upload_auth_header(self, sha256: str, mime_type: str) -> str:
+        tags = [
+            ["t", "upload"],
+            ["x", sha256],
+            ["expiration", str(int(time.time()) + (3600 if mime_type.startswith("video/") else 600))],
+        ]
+        parsed = urlsplit(self.relay_url.strip())
+        if parsed.netloc:
+            tags.append(["server", parsed.netloc])
+        event = self._signed_nostr_event(24242, tags, "Upload file")
+        encoded = base64.urlsafe_b64encode(
+            json.dumps(event, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+        ).decode("ascii").rstrip("=")
+        return f"Nostr {encoded}"
