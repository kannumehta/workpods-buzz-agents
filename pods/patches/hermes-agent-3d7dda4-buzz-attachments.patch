+    def _upload_generic_file_sync(self, local: Path) -> Dict[str, Any]:
+        data = local.read_bytes()
+        mime_type = mimetypes.guess_type(local.name)[0] or "application/octet-stream"
+        sha256 = hashlib.sha256(data).hexdigest()
+        upload_url = os.getenv("BUZZ_UPLOAD_URL", "").strip() or self._relay_http_url("/upload")
+        upload_host = os.getenv("BUZZ_UPLOAD_HOST", "").strip()
+        headers = {
+            "Authorization": self._blossom_upload_auth_header(sha256, mime_type),
+            "Content-Type": mime_type,
+            "Content-Length": str(len(data)),
+            "X-SHA-256": sha256,
+        }
+        if upload_host:
+            headers["Host"] = upload_host
+        request = urllib.request.Request(
+            upload_url,
+            data=data,
+            method="PUT",
+            headers=headers,
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=_MEDIA_CLI_TIMEOUT) as response:
+                body = response.read().decode("utf-8", errors="replace")
+        except urllib.error.HTTPError as e:
+            detail = e.read().decode("utf-8", errors="replace")
+            raise RuntimeError(f"generic upload failed: HTTP {e.code} {detail}") from e
+        except urllib.error.URLError as e:
+            raise RuntimeError(f"generic upload failed: {e}") from e
+        try:
+            descriptor = json.loads(body or "{}")
+        except ValueError as e:
+            raise RuntimeError(f"generic upload returned non-JSON response: {body[:200]}") from e
+        if not isinstance(descriptor, dict) or not descriptor.get("url"):
+            raise RuntimeError(f"generic upload returned no media URL: {body[:200]}")
+        return descriptor
+
