#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo_root"

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  printf 'refusing predeploy from a dirty tracked tree\n' >&2
  exit 1
fi

revision=$(git rev-parse HEAD)
image="workpods/hermes-codex:$revision"
umbrella=${WORKPODS_UMBRELLA_ROOT:-}
if [[ -z "$umbrella" ]]; then
  candidate=$repo_root
  while [[ "$candidate" != / ]]; do
    if [[ -f "$candidate/services.toml" && -d "$candidate/.runtime" ]]; then
      umbrella=$candidate
      break
    fi
    candidate=$(dirname "$candidate")
  done
fi
if [[ -z "$umbrella" ]]; then
  printf 'cannot locate WorkPods umbrella; set WORKPODS_UMBRELLA_ROOT\n' >&2
  exit 1
fi

secret_root="$umbrella/.runtime/secrets/hermes-pods"
state_root="$umbrella/.runtime/state/hermes-pods"
identities=(
  content-pod.env
  geo-pod.env
  lifecycle-pod.env
  performance-pod.env
  marketing-pod.env
  support-desk-pod.env
)
internal_identities=(
  content-pod.env
  geo-pod.env
  lifecycle-pod.env
  performance-pod.env
)
for identity in "${identities[@]}"; do
  path="$secret_root/$identity"
  if [[ ! -f "$path" || -L "$path" ]]; then
    printf 'identity must be a regular non-symlink file: %s\n' "$path" >&2
    exit 1
  fi
  mode=$(stat -c '%a' "$path")
  if [[ "$mode" != 600 ]]; then
    printf 'identity must have mode 600: %s (found %s)\n' "$path" "$mode" >&2
    exit 1
  fi
  owner=$(stat -c '%u:%g' "$path")
  if [[ "$owner" != 10000:10000 ]]; then
    printf 'identity must be owned by Hermes uid/gid 10000:10000: %s (found %s)\n' "$path" "$owner" >&2
    exit 1
  fi
done

gateway_env="$secret_root/llm-gateway.env"
if [[ ! -f "$gateway_env" || -L "$gateway_env" ]]; then
  printf 'gateway credentials must be a regular non-symlink file: %s\n' "$gateway_env" >&2
  exit 1
fi
gateway_mode=$(stat -c '%a' "$gateway_env")
gateway_owner=$(stat -c '%u:%g' "$gateway_env")
if [[ "$gateway_mode" != 600 || "$gateway_owner" != 10000:10000 ]]; then
  printf 'gateway credentials must be 0600 and owned by 10000:10000: %s (found %s %s)\n' \
    "$gateway_env" "$gateway_mode" "$gateway_owner" >&2
  exit 1
fi
grep_cmd=(grep)
if [[ ! -r "$gateway_env" ]]; then
  grep_cmd=(sudo -n grep)
fi
for required in OPENAI_API_KEY OPENAI_BASE_URL; do
  if ! "${grep_cmd[@]}" -Eq "^${required}=.+" "$gateway_env"; then
    printf 'gateway credentials are missing %s: %s\n' "$required" "$gateway_env" >&2
    exit 1
  fi
done

read_single_assignment() {
  local path=$1 key=$2
  local awk_cmd=(awk)
  if [[ ! -r "$path" ]]; then
    awk_cmd=(sudo -n awk)
  fi
  "${awk_cmd[@]}" -v key="$key" '
    index($0, key "=") == 1 { count += 1; line = $0 }
    END {
      if (count != 1 || line == key "=") exit 1
      print line
    }
  ' "$path"
}

# Multiplexed turns fail closed on the routed profile's secret scope. They do
# not borrow provider credentials from the container environment, so each
# internal profile must carry the same gateway endpoint and client token as
# llm-gateway.env.
for identity in "${internal_identities[@]}"; do
  path="$secret_root/$identity"
  for required in OPENAI_API_KEY OPENAI_BASE_URL; do
    if ! cmp -s \
      <(read_single_assignment "$gateway_env" "$required") \
      <(read_single_assignment "$path" "$required"); then
      printf '%s must define the same %s as llm-gateway.env\n' \
        "$path" "$required" >&2
      exit 1
    fi
  done
done

if [[ ! -d "$state_root" ]]; then
  printf 'Hermes state root is missing: %s\n' "$state_root" >&2
  exit 1
fi
find_cmd=(find)
if ! find "$state_root" -name auth.json -print -quit >/dev/null 2>&1; then
  find_cmd=(sudo -n find)
fi
auth_files=$("${find_cmd[@]}" "$state_root" -name auth.json -print)
while IFS= read -r auth_file; do
  [[ -n "$auth_file" ]] || continue
  printf 'direct provider auth must be archived before gateway-only deployment: %s\n' \
    "$auth_file" >&2
  exit 1
done <<<"$auth_files"

docker_cmd=(docker)
if ! docker info >/dev/null 2>&1; then
  sudo -n docker info >/dev/null
  docker_cmd=(sudo -n docker)
fi
compose_cmd=(env "WORKPODS_BUILD_REVISION=$revision" docker compose)
if [[ "${docker_cmd[0]}" == sudo || ! -r "$secret_root/${identities[0]}" ]]; then
  sudo -n true >/dev/null
  compose_cmd=(sudo -n env "WORKPODS_BUILD_REVISION=$revision" docker compose)
fi
actual=$("${docker_cmd[@]}" image inspect "$image" \
  --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')
test "$actual" = "$revision"
# shellcheck source=../../buzz-acp/UPSTREAM
source "$repo_root/buzz-acp/UPSTREAM"
actual_head=$("${docker_cmd[@]}" image inspect "$image" \
  --format '{{index .Config.Labels "io.workpods.buzz.patch-head"}}')
actual_tree=$("${docker_cmd[@]}" image inspect "$image" \
  --format '{{index .Config.Labels "io.workpods.buzz.patch-tree"}}')
test "$actual_head" = "$PATCH_HEAD"
test "$actual_tree" = "$PATCH_TREE"

rollback_root=${WORKPODS_ROLLBACK_ARCHIVE_ROOT:?set to the cold rollback archive directory}
checksum="$rollback_root/hermes-codex-rollback-bc2171345764.tar.sha256"
test -f "$checksum"
(cd "$rollback_root" && sha256sum -c "$(basename "$checksum")")
"${docker_cmd[@]}" image inspect \
  workpods/hermes-codex:rollback-bc2171345764 >/dev/null

"${compose_cmd[@]}" \
  -f pods/compose.pods.yml config --quiet
printf 'predeploy checks passed for %s\n' "$image"
