FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep curl \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @agentclientprotocol/codex-acp@1.4.0 @openai/codex@0.147.0

COPY scripts/codex-pod-entrypoint /usr/local/bin/codex-pod-entrypoint
COPY pods /opt/workpods/pods

RUN chmod 755 /usr/local/bin/codex-pod-entrypoint \
    && mkdir -p /var/lib/workpods-buzz-agent/workspace /var/log/workpods-buzz-agent

WORKDIR /var/lib/workpods-buzz-agent/workspace
ENTRYPOINT ["/usr/local/bin/codex-pod-entrypoint"]
CMD ["buzz-acp"]
