+fn deserialize_session_channels<'de, D>(
+    deserializer: D,
+) -> Result<HashMap<String, PersistedChannelSession>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    struct ChannelsVisitor;
+
+    impl<'de> serde::de::Visitor<'de> for ChannelsVisitor {
+        type Value = HashMap<String, PersistedChannelSession>;
+
+        fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            formatter.write_str("a map of unique channel IDs to ACP sessions")
+        }
+
+        fn visit_map<A>(self, mut map: A) -> Result<Self::Value, A::Error>
+        where
+            A: serde::de::MapAccess<'de>,
+        {
+            let mut channels = HashMap::with_capacity(map.size_hint().unwrap_or(0));
+            while let Some((channel, session)) =
+                map.next_entry::<String, PersistedChannelSession>()?
+            {
+                if channels.insert(channel.clone(), session).is_some() {
+                    return Err(serde::de::Error::custom(format!(
+                        "duplicate session state channel {channel:?}"
+                    )));
+                }
+            }
+            Ok(channels)
+        }
+    }
+
+    deserializer.deserialize_map(ChannelsVisitor)
+}
