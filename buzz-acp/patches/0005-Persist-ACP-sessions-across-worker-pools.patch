+async fn apply_live_channel_session_config(
+    agent: &mut OwnedAgent,
+    ctx: &PromptContext,
+    channel_id: Uuid,
+    session_id: &str,
+) -> Result<(), AcpError> {
+    let session_override = ctx
+        .session_overrides
+        .lock()
+        .ok()
+        .and_then(|overrides| overrides.get(&channel_id).cloned());
+
+    let Some(session_override) = session_override else {
+        return Ok(());
+    };
+
+    if let Some(desired) = session_override.model.as_deref() {
+        let Some(caps) = agent.model_capabilities.as_ref() else {
+            tracing::warn!(
+                target: "pool::model",
+                "cannot apply live model {desired} on session {session_id}: model catalog is unavailable"
+            );
+            return Ok(());
+        };
+        let mut catalog = serde_json::json!({
+            "configOptions": caps.config_options_raw.clone(),
+        });
+        if let Some(models) = caps.available_models_raw.as_ref() {
+            catalog["models"] = models.clone();
+        }
+        match resolve_model_switch_method(&catalog, desired) {
+            Some(method) => {
+                apply_model_switch(&mut agent.acp, session_id, desired, &method).await?;
+            }
+            None => {
+                tracing::warn!(
+                    target: "pool::model",
+                    "desired model {desired} not found for live session {session_id} — keeping current model"
+                );
+                agent.acp.observe(
+                    "control_result",
+                    serde_json::json!({
+                        "type": "switch_model",
+                        "status": "unsupported_model",
+                        "modelId": desired,
+                    }),
+                );
+            }
+        }
+    }
+
+    if let Some(mode) = session_override.permission_mode {
+        if let Some(wire_mode) = agent.model_capabilities.as_ref().and_then(|caps| {
+            select_supported_permission_mode_from_modes(caps.modes_raw.as_ref(), mode)
+        }) {
+            apply_permission_mode(&mut agent.acp, session_id, wire_mode).await?;
+        } else {
+            tracing::info!(
+                target: "pool::permission",
+                "live session mode {mode} has no advertised ACP mode for session {session_id} — using adapter/process defaults"
+            );
+        }
+    }
+
+    Ok(())
+}
