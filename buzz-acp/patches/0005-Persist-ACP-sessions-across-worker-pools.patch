+        let server = tokio::spawn(async move {
+            while let Ok((mut socket, _)) = listener.accept().await {
+                let mut bytes = Vec::new();
+                let mut buf = [0_u8; 4096];
+                let mut header_end = None;
+                let mut content_len = None;
+                loop {
+                    let Ok(n) = socket.read(&mut buf).await else {
+                        break;
+                    };
+                    if n == 0 {
+                        break;
+                    }
+                    bytes.extend_from_slice(&buf[..n]);
+                    if header_end.is_none() {
+                        if let Some(pos) =
+                            bytes.windows(4).position(|window| window == b"\r\n\r\n")
+                        {
+                            header_end = Some(pos + 4);
+                            let headers = String::from_utf8_lossy(&bytes[..pos]);
+                            content_len = headers.lines().find_map(|line| {
+                                let (name, value) = line.split_once(':')?;
+                                if name.eq_ignore_ascii_case("content-length") {
+                                    value.trim().parse::<usize>().ok()
+                                } else {
+                                    None
+                                }
+                            });
+                        }
+                    }
+                    if let (Some(start), Some(len)) = (header_end, content_len) {
+                        if bytes.len() >= start + len {
+                            break;
+                        }
+                    }
+                }
+
+                let header_end = header_end.unwrap_or(bytes.len());
+                let headers = String::from_utf8_lossy(&bytes[..header_end]).to_string();
+                let body_len = content_len.unwrap_or(0);
+                let body_end = (header_end + body_len).min(bytes.len());
+                let body = &bytes[header_end..body_end];
+                if headers.starts_with("POST /events ") {
+                    if let Ok(event) = serde_json::from_slice::<serde_json::Value>(body) {
+                        let _ = event_tx.send(event);
+                    }
+                }
+                let response_body = if headers.starts_with("POST /query ") {
+                    "[]"
+                } else {
+                    "{}"
+                };
+                let response = format!(
+                    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                    response_body.len(),
+                    response_body
+                );
+                let _ = socket.write_all(response.as_bytes()).await;
+            }
+        });
+
+        let script = r#"IFS= read -r line
+printf '%s\n' '{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"live-session","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"adapter reply"}}}}'
+printf '%s\n' '{"jsonrpc":"2.0","id":0,"result":{"stopReason":"end_turn"}}'"#;
+        let acp = AcpClient::spawn("bash", &["-c".into(), script.into()], &[], false)
+            .await
+            .expect("spawn reply ACP script");
+        let channel_id = Uuid::new_v4();
+        let mut agent = OwnedAgent {
