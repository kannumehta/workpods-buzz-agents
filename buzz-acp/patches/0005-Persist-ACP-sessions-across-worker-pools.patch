+fn append_assistant_text_chunk(buffer: &mut String, chunk: &str) {
+    if chunk.is_empty() {
+        return;
+    }
+    if let Some(separator) = assistant_chunk_separator(buffer, chunk) {
+        buffer.push_str(separator);
+    }
+    buffer.push_str(chunk);
+}
+
+fn assistant_chunk_separator(buffer: &str, chunk: &str) -> Option<&'static str> {
+    let previous = buffer.chars().next_back()?;
+    let next = chunk.chars().next()?;
+
+    if previous.is_whitespace() || next.is_whitespace() {
+        return None;
+    }
+
+    if next == '@' {
+        return if is_sentence_boundary(previous) {
+            Some("\n\n")
+        } else {
+            Some(" ")
+        };
+    }
+
+    if is_sentence_boundary(previous) && starts_sentence_like(next) {
+        return Some(" ");
+    }
+
+    None
+}
+
+fn is_sentence_boundary(ch: char) -> bool {
+    matches!(ch, '.' | '!' | '?' | ':' | ';')
+}
+
+fn starts_sentence_like(ch: char) -> bool {
+    ch.is_ascii_uppercase() || ch.is_ascii_digit() || ch == '`' || ch == '"' || ch == '\''
+}
