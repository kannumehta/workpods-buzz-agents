+    /// Load an existing ACP session into the current agent process.
+    ///
+    /// `session/load` is used by adapters that keep durable session state
+    /// outside the current process. The request intentionally mirrors the
+    /// workspace shape of `session/new`, without a system prompt.
+    pub async fn session_load(
+        &mut self,
+        session_id: &str,
+        cwd: &str,
+        additional_directories: &[String],
+        mcp_servers: Vec<McpServer>,
+    ) -> Result<serde_json::Value, AcpError> {
+        let params = build_existing_session_params(
+            session_id,
+            cwd,
+            additional_directories,
+            mcp_servers,
+        );
+        let result = self.send_request("session/load", params).await?;
+        tracing::info!(target: "acp::session", "session loaded: {session_id}");
+        Ok(result)
+    }
