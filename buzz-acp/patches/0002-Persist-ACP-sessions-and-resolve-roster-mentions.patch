+fn merge_profile_lookups(
+    primary: Option<&PromptProfileLookup>,
+    secondary: Option<PromptProfileLookup>,
+) -> Option<PromptProfileLookup> {
+    match (primary, secondary) {
+        (None, None) => None,
+        (Some(primary), None) => Some(primary.clone()),
+        (None, Some(secondary)) => Some(secondary),
+        (Some(primary), Some(mut secondary)) => {
+            for (pubkey, profile) in primary {
+                secondary.insert(pubkey.clone(), profile.clone());
+            }
+            Some(secondary)
+        }
+    }
+}
