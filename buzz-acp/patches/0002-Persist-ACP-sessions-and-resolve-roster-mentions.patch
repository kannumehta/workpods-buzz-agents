+async fn fetch_channel_member_profiles(
+    channel_id: Uuid,
+    rest: &RestClient,
+) -> Option<PromptProfileLookup> {
+    use nostr::{Alphabet, SingleLetterTag};
+
+    let d_tag = SingleLetterTag::lowercase(Alphabet::D);
+    let channel = channel_id.to_string();
+    let filter = nostr::Filter::new()
+        .kind(nostr::Kind::Custom(
+            buzz_core::kind::KIND_NIP29_GROUP_MEMBERS as u16,
+        ))
+        .custom_tags(d_tag, [channel.as_str()]);
+
+    let member_events = fetch_with_retry(|| async {
+        match timeout(
+            CONTEXT_FETCH_TIMEOUT,
+            rest.query(std::slice::from_ref(&filter)),
+        )
+        .await
+        {
+            Ok(Ok(json)) => Some(json),
+            Ok(Err(e)) => {
+                tracing::debug!("channel member lookup failed: {e} — will retry");
+                None
+            }
+            Err(_) => {
+                tracing::debug!("channel member lookup timed out — will retry");
+                None
+            }
+        }
+    })
+    .await?;
+
+    let mut pubkeys = HashSet::new();
+    for event in member_events.as_array()? {
+        let Some(tags) = event.get("tags").and_then(|tags| tags.as_array()) else {
+            continue;
+        };
+        for tag in tags {
+            let Some(parts) = tag.as_array() else {
+                continue;
+            };
+            if parts.first().and_then(|v| v.as_str()) != Some("p") {
+                continue;
+            }
+            if let Some(pubkey) = parts.get(1).and_then(|v| v.as_str()) {
+                if nostr::PublicKey::from_hex(pubkey).is_ok() {
+                    pubkeys.insert(pubkey.to_ascii_lowercase());
+                }
+            }
+        }
+    }
+    fetch_profiles_for_pubkeys(&pubkeys, rest).await
+}
