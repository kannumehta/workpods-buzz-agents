+
+impl SessionStateStore {
+    pub fn new(path: PathBuf) -> Self {
+        Self {
+            path: Arc::new(path),
+        }
+    }
+
+    pub fn path(&self) -> &PathBuf {
+        &self.path
+    }
+
+    pub fn load(&self) -> PersistedSessionSnapshot {
+        let Ok(bytes) = std::fs::read(&*self.path) else {
+            return PersistedSessionSnapshot::default();
+        };
+        let Ok(file) = serde_json::from_slice::<PersistedSessionFile>(&bytes) else {
+            tracing::warn!(
+                target: "pool::session_store",
+                path = %self.path.display(),
+                "failed to parse session state file; starting with empty runtime state"
+            );
+            return PersistedSessionSnapshot::default();
+        };
+
+        let mut snapshot = PersistedSessionSnapshot::default();
+        for (channel, entry) in file.channels {
+            let Ok(channel_id) = channel.parse::<Uuid>() else {
+                tracing::warn!(
+                    target: "pool::session_store",
+                    channel,
+                    "ignoring invalid channel id in session state file"
+                );
+                continue;
+            };
+            if entry.session_id.trim().is_empty() {
+                continue;
+            }
+            snapshot
+                .state
+                .sessions
+                .insert(channel_id, entry.session_id);
+            if entry.turn_count > 0 {
+                snapshot.state.turn_counts.insert(channel_id, entry.turn_count);
+            }
+            let mut session_override = SessionOverride::default();
+            session_override.model = entry.model.filter(|m| !m.trim().is_empty());
+            session_override.permission_mode = entry
+                .permission_mode
+                .as_deref()
+                .and_then(parse_persisted_permission_mode);
+            if session_override.model.is_some() || session_override.permission_mode.is_some() {
+                snapshot.overrides.insert(channel_id, session_override);
+            }
+        }
+        snapshot
+    }
+
+    pub fn save(
+        &self,
+        state: &SessionState,
+        overrides: &HashMap<Uuid, SessionOverride>,
+    ) -> std::io::Result<()> {
+        if let Some(parent) = self.path.parent() {
+            std::fs::create_dir_all(parent)?;
+        }
+        let mut file = PersistedSessionFile::default();
+        for (channel_id, session_id) in &state.sessions {
+            let session_override = overrides.get(channel_id);
+            file.channels.insert(
+                channel_id.to_string(),
+                PersistedChannelSession {
+                    session_id: session_id.clone(),
+                    turn_count: state.turn_counts.get(channel_id).copied().unwrap_or(0),
+                    model: session_override.and_then(|o| o.model.clone()),
+                    permission_mode: session_override
+                        .and_then(|o| o.permission_mode)
+                        .map(|mode| mode.as_public_str().to_string()),
+                },
+            );
+        }
+        let json = serde_json::to_vec_pretty(&file)?;
+        let tmp_path = self.path.with_extension("json.tmp");
+        std::fs::write(&tmp_path, json)?;
+        std::fs::rename(tmp_path, &*self.path)
+    }
+}
+
+fn parse_persisted_permission_mode(raw: &str) -> Option<PermissionMode> {
+    match raw.trim() {
+        "plan" => Some(PermissionMode::Plan),
+        "auto" | "bypass" | "bypassPermissions" => Some(PermissionMode::Auto),
+        "edit" | "acceptEdits" => Some(PermissionMode::Edit),
+        _ => {
+            tracing::warn!(
+                target: "pool::session_store",
+                mode = raw,
+                "ignoring invalid persisted permission mode"
+            );
+            None
+        }
+    }
+}
