+fn select_permission_option<'a>(
+    options: &'a [serde_json::Value],
+    mode: PermissionMode,
+    tool_kind: Option<&str>,
+) -> Option<&'a str> {
+    let allow_kinds: &[&str] = match mode {
+        PermissionMode::Auto => &["allow_once", "allow_always"],
+        PermissionMode::Edit if tool_kind == Some("edit") => &["allow_once", "allow_always"],
+        PermissionMode::Edit | PermissionMode::Plan => &[],
+    };
+
+    for kind in allow_kinds {
+        if let Some(option_id) = option_id_for_kind(options, kind) {
+            return Some(option_id);
+        }
+    }
+
+    option_id_for_kind(options, "reject_once")
+        .or_else(|| option_id_for_kind(options, "reject_always"))
+}
+
+fn option_id_for_kind<'a>(options: &'a [serde_json::Value], kind: &str) -> Option<&'a str> {
+    options.iter().find_map(|opt| {
+        (opt.get("kind").and_then(|k| k.as_str()) == Some(kind))
+            .then(|| opt.get("optionId").and_then(|id| id.as_str()))
+            .flatten()
+    })
+}
