+fn effective_permission_mode(ctx: &PromptContext, channel_id: Option<Uuid>) -> PermissionMode {
+    channel_id
+        .and_then(|cid| {
+            ctx.session_overrides.lock().ok().and_then(|overrides| {
+                overrides
+                    .get(&cid)
+                    .and_then(|session| session.permission_mode)
+            })
+        })
+        .unwrap_or(ctx.permission_mode)
+}
