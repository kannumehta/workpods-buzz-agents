+    content: &str,
+    mentions: &[String],
+) {
+    let Some(thread_tags) = reply_thread_tags_for_batch(batch) else {
+        return;
+    };
+    post_visible_message(rest, channel_id, &thread_tags, content, mentions).await;
+}
+
+/// Best-effort: post a visible failure notice after a batch is dead-lettered.
