+/// Slash commands consumed by the harness instead of forwarded to the ACP
+/// adapter. These mutate only the current Buzz channel's runtime session.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum SessionControlCommand {
+    SetModel(String),
+    SetMode(PermissionMode),
+    ShowSession,
+    ResetSession,
+}
+
+fn parse_permission_mode_arg(raw: &str) -> Option<PermissionMode> {
+    match raw {
+        "plan" => Some(PermissionMode::Plan),
+        "auto" => Some(PermissionMode::Auto),
+        "edit" => Some(PermissionMode::Edit),
+        _ => None,
+    }
+}
+
+fn parse_session_control_command(content: &str) -> Option<Result<SessionControlCommand, String>> {
+    let slash = queue::extract_slash_command(content, &[])?;
+    let mut parts = slash.split_whitespace();
+    let command = parts.next()?;
+    match command {
+        "/model" => {
+            let Some(model) = parts.next() else {
+                return Some(Err("Usage: /model <model-id>".into()));
+            };
+            if parts.next().is_some() {
+                return Some(Err("Usage: /model <model-id>".into()));
+            }
+            Some(Ok(SessionControlCommand::SetModel(model.to_string())))
+        }
+        "/mode" => {
+            let Some(mode) = parts.next() else {
+                return Some(Err("Usage: /mode <plan|auto|edit>".into()));
+            };
+            if parts.next().is_some() {
+                return Some(Err("Usage: /mode <plan|auto|edit>".into()));
+            }
+            match parse_permission_mode_arg(mode) {
+                Some(mode) => Some(Ok(SessionControlCommand::SetMode(mode))),
+                None => Some(Err("Unknown mode. Use one of: plan, auto, edit.".into())),
+            }
+        }
+        "/session" => Some(Ok(SessionControlCommand::ShowSession)),
+        "/reset-session" => {
+            if parts.next().is_some() {
+                return Some(Err("Usage: /reset-session".into()));
+            }
+            Some(Ok(SessionControlCommand::ResetSession))
+        }
+        _ => None,
+    }
+}
+
