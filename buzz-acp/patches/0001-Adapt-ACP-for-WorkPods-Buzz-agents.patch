+fn reply_thread_tags_for_batch(batch: &FlushBatch) -> Option<ThreadTags> {
+    let last = batch.events.last()?;
+    let parsed = crate::queue::parse_thread_tags(&last.event);
+    let parent = last.event.id.to_hex();
+    let root = parsed.root_event_id.unwrap_or_else(|| parent.clone());
+    Some(ThreadTags {
+        root_event_id: Some(root),
+        parent_event_id: Some(parent),
+        mentioned_pubkeys: Vec::new(),
+    })
+}
+
+fn normalize_reply_name(name: &str) -> Option<String> {
+    let normalized = name.trim().trim_start_matches('@').to_ascii_lowercase();
+    if normalized.is_empty() {
+        None
+    } else {
+        Some(normalized)
+    }
+}
+
+fn resolve_reply_mentions(
+    content: &str,
+    profiles: Option<&PromptProfileLookup>,
+    sender_pubkey: &str,
+) -> Vec<String> {
+    let Some(profiles) = profiles else {
+        return Vec::new();
+    };
+
+    let mut known_names = Vec::new();
+    let mut name_to_pubkeys: HashMap<String, Vec<String>> = HashMap::new();
+    for (pubkey, profile) in profiles {
+        for name in [
+            profile.display_name.as_deref(),
+            profile.nip05_handle.as_deref(),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if let Some(normalized) = normalize_reply_name(name) {
+                if !known_names.contains(&normalized) {
+                    known_names.push(normalized.clone());
+                }
+                let pubkeys = name_to_pubkeys.entry(normalized).or_default();
+                if !pubkeys.contains(pubkey) {
+                    pubkeys.push(pubkey.clone());
+                }
+            }
+        }
+    }
+
+    let known_refs: Vec<&str> = known_names.iter().map(String::as_str).collect();
+    let mut resolved = Vec::new();
+    for name in buzz_sdk::mentions::extract_at_mentions_with_known(content, &known_refs) {
+        if let Some(candidates) = name_to_pubkeys.get(&name) {
+            if candidates.len() == 1 {
+                resolved.push(candidates[0].clone());
+            }
+        }
+    }
+    buzz_sdk::mentions::normalize_mention_pubkeys(&resolved, Some(sender_pubkey))
+}
+
+async fn post_agent_reply(
+    rest: &crate::relay::RestClient,
+    channel_id: Uuid,
